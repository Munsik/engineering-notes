---
// 글 제목 위에 "영역 › 컬렉션" 위치를 작게 보여 줍니다.
// 검색으로 글 하나에 바로 들어온 사람도 어느 기술의 어떤 주제인지 알 수 있게 하기 위해서입니다.
// - 컬렉션 글: 영역 › 컬렉션, 컬렉션 개요: 영역, 영역 개요와 영역 밖 페이지: 표시하지 않음
// - 이름은 영역과 컬렉션 index.md의 title이고, 각각 개요 페이지로 링크합니다. 영어 페이지는 영어 index.md를 씁니다.
// - 오른쪽에는 Markdown 원문 보기와 복사 버튼을 둡니다.
// - 영어 번역 페이지는 제목 아래에 한국어 원문 링크를, 원문이 번역 뒤에 바뀌었으면 안내를 보여 줍니다(src/lib/translation.mjs).
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { getCollection } from 'astro:content';
import { findArea, findCollection, findExtra } from '../site-areas.mjs';
import { baseIdOf, localizedId, t, toLocale } from '../lib/i18n.mjs';
import { translationStatus } from '../lib/translation.mjs';

const route = Astro.locals.starlightRoute;
const locale = toLocale(route.locale);
const docs = await getCollection('docs');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const indexOf = (dir: string) => {
	const id = localizedId(dir, locale);
	return docs.find((d) => d.id === id || d.id === `${id}/index`);
};
const href = (dir: string) => `${base}/${localizedId(dir, locale)}/`;

const pageId = route.id.replace(/(^|\/)index$/, '');
const id = baseIdOf(pageId);
const area = findArea(id);
const collection = findCollection(id);

const trail = [];
if (area && id !== area.dir) {
	trail.push({ label: indexOf(area.dir)?.data.title, href: href(area.dir) });
	if (collection && id !== collection.dir) {
		trail.push({ label: indexOf(collection.dir)?.data.title, href: href(collection.dir) });
	}
}
const crumbs = trail.filter((c) => c.label);

// 같은 글의 Markdown 원문(src/pages/[...slug].md.js). AI 도구에 글을 넣어 쓰는 독자를 위해 보기와 복사를 둡니다.
// 번역이 없는 영어 주소(fallback)는 원문 파일이 없으므로 버튼을 두지 않습니다.
const entry = route.entry;
const markdownHref =
	id && (area || findExtra(id)) && entry.filePath.endsWith('.md') && !route.isFallback ? `${base}/${pageId}.md` : undefined;

// 영어 번역 표시
const isTranslation = locale === 'en' && !route.isFallback;
const sourceHref = `${base}/${id ? `${id}/` : ''}`;
const stale = isTranslation && translationStatus(entry.filePath, entry.data.translatedFrom).stale;
---

{
	(crumbs.length > 0 || markdownHref) && (
		<div class="en-title-bar">
			<nav class="en-trail" aria-label={t(locale, 'trailNav')}>
				{crumbs.map((c, i) => (
					<>
						{i > 0 && <span aria-hidden="true">›</span>}
						<a href={c.href}>{c.label}</a>
					</>
				))}
			</nav>
			{markdownHref && (
				<div class="en-md-actions">
					<a href={markdownHref}>Markdown</a>
					<button
						type="button"
						data-en-copy-md={markdownHref}
						data-copied={t(locale, 'copied')}
						data-failed={t(locale, 'copyFailed')}
					>
						{t(locale, 'copy')}
					</button>
				</div>
			)}
		</div>
	)
}
<Default />
{
	isTranslation && (
		<p class="en-translation">
			Translated from the <a href={sourceHref} hreflang="ko" lang="ko">Korean original</a>.
			{stale && <strong class="en-translation-stale"> {t(locale, 'staleTranslation')}</strong>}
		</p>
	)
}

<script>
	// Markdown 원문을 받아 클립보드에 복사합니다. 결과는 버튼 글자로 잠시 알려 줍니다.
	document.querySelectorAll<HTMLButtonElement>('[data-en-copy-md]').forEach((button) => {
		button.addEventListener('click', async () => {
			const label = button.textContent;
			try {
				const text = await (await fetch(button.dataset.enCopyMd!)).text();
				await navigator.clipboard.writeText(text);
				button.textContent = button.dataset.copied ?? '';
			} catch {
				button.textContent = button.dataset.failed ?? '';
			}
			setTimeout(() => (button.textContent = label), 1500);
		});
	});
</script>

<style>
	.en-title-bar {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem 1rem;
		margin-top: 1rem;
	}
	.en-title-bar .en-trail {
		margin-top: 0;
	}
	.en-md-actions {
		display: flex;
		gap: 0.25rem;
		font-size: var(--sl-text-xs);
	}
	.en-md-actions :is(a, button) {
		padding: 0.15rem 0.55rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.25rem;
		background: transparent;
		color: var(--sl-color-gray-2);
		font: inherit;
		text-decoration: none;
		cursor: pointer;
	}
	.en-md-actions :is(a, button):hover {
		border-color: var(--sl-color-text-accent);
		color: var(--sl-color-text-accent);
	}
	.en-trail {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		align-items: center;
		margin-top: 1rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.en-trail a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.en-trail a:hover {
		color: var(--sl-color-text-accent);
	}
	.en-translation {
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.en-translation-stale {
		display: block;
		margin-top: 0.25rem;
		color: var(--sl-color-orange-high);
		font-weight: 400;
	}
	.en-title-bar + :global(h1) {
		margin-top: 0.25rem;
	}
</style>
