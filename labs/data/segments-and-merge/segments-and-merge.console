# Engineering Notes - data/01, data/02 에서 쓰는 요청 모음
# Kibana Dev Tools Console에 붙여 넣고 필요한 요청만 골라 실행합니다.
# <index> 는 확인할 인덱스 이름으로 바꿉니다.

# ---------- 01. Segment의 생애 ----------

# segment 목록과 상태(검색 가능, commit 여부, 삭제 문서)
GET _cat/segments/<index>?v&h=segment,generation,docs.count,docs.deleted,size,committed,searchable,compound

# 인덱스 단위 문서 수, 삭제 문서 수, 크기
GET _cat/indices/<index>?v&h=index,docs.count,docs.deleted,store.size

# refresh, flush, translog 통계
GET <index>/_stats/refresh,flush,translog

# 필드별, 구성 요소별 저장 공간. 비용이 큰 작업이라 run_expensive_tasks=true가 필요합니다.
POST <index>/_disk_usage?run_expensive_tasks=true

# shard history retention lease
GET <index>/_stats?level=shards&filter_path=indices.*.shards.*.retention_leases,indices.*.shards.*.seq_no

# 적용된 기본값 확인 (refresh, search idle, translog, merge policy)
GET <index>/_settings?include_defaults=true&filter_path=**.refresh_interval,**.search.idle.after,**.translog.durability,**.translog.flush_threshold_size,**.translog.flush_threshold_age,**.merge.policy.type,**.merge.policy.expunge_deletes_allowed,**.soft_deletes.retention_lease.period

# 대량 적재 전후 설정 (공식 권장)
PUT <index>/_settings
{
  "index": {
    "refresh_interval": "-1",
    "number_of_replicas": 0
  }
}

PUT <index>/_settings
{
  "index": {
    "refresh_interval": null,
    "number_of_replicas": 1
  }
}

# ---------- 02. Merge와 force merge ----------

# merge, indexing throttle 통계
GET <index>/_stats/merge,indexing?filter_path=indices.*.primaries.merges,indices.*.primaries.indexing.throttle_time_in_millis

# 노드별 merge, force_merge thread pool
GET _cat/thread_pool/merge,force_merge?v&h=node_name,name,active,queue,max,size

# 지운 문서가 있는 segment만 다시 쓰기
POST <index>/_forcemerge?only_expunge_deletes=true

# 쓰기가 끝난 인덱스를 segment 1개로 합치기. 노드에 shard 크기의 세 배까지 여유 공간이 있어야 합니다.
POST <index>/_forcemerge?max_num_segments=1&wait_for_completion=false

# 위 요청이 돌려준 task 상태 확인 (force merge task는 취소할 수 없습니다)
GET _tasks?actions=*forcemerge*&detailed=true

# 9.5.5에서 TieredMergePolicy 기본값을 확인한 소스: MergePolicyConfig.java
# segments_per_tier 8, floor_segment 16mb, max_merged_segment 5gb, deletes_pct_allowed 20, expunge_deletes_allowed 10
# 시간 기반(LogByteSize): merge_factor 32, max_time_based_merged_segment 100gb
