// P1-a Agent 출력 acked(누적 카운터 → 구간 차이)
FROM metrics-elastic_agent.filebeat-*
| STATS acked = MAX(beat.stats.libbeat.output.events.acked) - MIN(beat.stats.libbeat.output.events.acked) BY t = BUCKET(@timestamp, 5 minutes), agent.id, component.id
| STATS agent_acked = SUM(acked) BY t
| SORT t

// P1-b Logstash 입력 처리량(초당). 5분 버킷 비교를 위해 300을 곱함
FROM metrics-logstash.pipeline-*
| STATS eps = AVG(logstash.pipeline.flow.input_throughput.current) BY t = BUCKET(@timestamp, 5 minutes), logstash.pipeline.name
| STATS logstash_in = SUM(eps) * 300 BY t
| SORT t

// P1-c Elasticsearch에 저장된 문서(event.ingested 기준)
FROM logs-*
| WHERE event.ingested IS NOT NULL
| STATS stored = COUNT(*) BY t = BUCKET(event.ingested, 5 minutes)
| SORT t

// P2 수집 지연
FROM logs-*
| WHERE event.ingested IS NOT NULL
| EVAL lag_s = DATE_DIFF("seconds", @timestamp, event.ingested)
| STATS p50 = PERCENTILE(lag_s, 50), p95 = PERCENTILE(lag_s, 95) BY t = BUCKET(@timestamp, 5 minutes)
| SORT t

// P3 Agent queue 사용률 상위
FROM metrics-elastic_agent.filebeat-*
| WHERE @timestamp >= NOW() - 15 minutes
| STATS filled = MAX(beat.stats.libbeat.pipeline.queue.filled.pct) BY agent.name, component.id
| SORT filled DESC
| LIMIT 20

// P4 Logstash backpressure, worker 사용률
FROM metrics-logstash.pipeline-*
| STATS backpressure = AVG(logstash.pipeline.flow.queue_backpressure.current), worker_util = AVG(logstash.pipeline.flow.worker_utilization.current) BY t = BUCKET(@timestamp, 5 minutes), logstash.pipeline.name
| SORT t

// P5 UDP drop(gauge 성격의 누적값 → 구간 차이). 필드 경로는 lab에서 확인
FROM metrics-elastic_agent.filebeat_input-*
| WHERE system_packet_drops IS NOT NULL
| STATS drops = MAX(system_packet_drops) - MIN(system_packet_drops) BY t = BUCKET(@timestamp, 5 minutes), agent.name
| SORT t

// P6 실패 문서
FROM logs-*::failures
| STATS failed = COUNT(*) BY data_stream.dataset, error.type
| SORT failed DESC

// P7 원천별 마지막 수신(알림 rule에도 사용)
FROM logs-*
| WHERE event.ingested >= NOW() - 1 day
| STATS last_ingested = MAX(event.ingested) BY data_stream.dataset, host.name
| EVAL silent_min = DATE_DIFF("minutes", last_ingested, NOW())
| WHERE silent_min >= 15
| SORT silent_min DESC
