// 흐름 대시보드 패널 정의. Stack 9.5.5 lab에서 실행 확인(Logstash 2대, Agent 3대로 확인)
// Agent self-monitoring 지표는 9.2 이후 Agent에서 metrics-elastic_agent.elastic_agent-*에 component.id별로 들어온다.
// 이전 Agent가 섞여 있으면 metrics-elastic_agent.filebeat-*도 같이 지정한다(없는 패턴은 무시된다).
// 두 data stream은 TSDS이고 누적값은 counter 타입이라 MAX, MIN 대신 TS + INCREASE를 쓴다(9.4 GA).

// P1-a Agent 출력 acked(5분 증가분). monitoring component와, Elasticsearch 출력일 때 같은 값을 한 번 더 보고하는 elasticsearch-* component를 뺀다
TS metrics-elastic_agent.elastic_agent-*, metrics-elastic_agent.filebeat-*
| WHERE NOT component.id LIKE "*monitoring*" AND NOT component.id LIKE "elasticsearch-*"
| STATS agent_acked = SUM(INCREASE(beat.stats.libbeat.output.events.acked)) BY t = TBUCKET(5 minutes)
| SORT t

// P1-b Logstash 입력 건수(5분 증가분). events.in은 counter. in은 예약어라 backtick으로 감싼다
TS metrics-logstash.pipeline-*
| STATS logstash_in = SUM(INCREASE(`logstash.pipeline.total.events.in`)) BY t = TBUCKET(5 minutes)
| SORT t

// P1-c Elasticsearch에 저장된 문서(event.ingested 기준)
FROM logs-*
| WHERE event.ingested IS NOT NULL
| STATS stored = COUNT(*) BY t = BUCKET(event.ingested, 5 minutes)
| SORT t

// P2 수집 지연
FROM logs-*
| WHERE event.ingested IS NOT NULL
| EVAL lag_s = DATE_DIFF("seconds", @timestamp, event.ingested)
| STATS p50 = PERCENTILE(lag_s, 50), p95 = PERCENTILE(lag_s, 95) BY t = BUCKET(@timestamp, 5 minutes)
| SORT t

// P3 Agent queue 사용률 상위. filled.pct는 0에서 1 사이 비율
FROM metrics-elastic_agent.elastic_agent-*, metrics-elastic_agent.filebeat-*
| WHERE @timestamp >= NOW() - 15 minutes AND beat.stats.libbeat.pipeline.queue.filled.pct IS NOT NULL
| STATS filled = MAX(beat.stats.libbeat.pipeline.queue.filled.pct) BY agent.name, component.id
| SORT filled DESC
| LIMIT 20

// P4 Logstash backpressure, worker 사용률(gauge). 노드별로 본다
FROM metrics-logstash.pipeline-*
| STATS backpressure = AVG(logstash.pipeline.total.flow.queue_backpressure.current), worker_util = AVG(logstash.pipeline.total.flow.worker_utilization.current) BY t = BUCKET(@timestamp, 5 minutes), logstash.pipeline.host.name
| SORT t

// P5 UDP drop 증가분. system_packet_drops는 counter
TS metrics-elastic_agent.filebeat_input-*
| WHERE filebeat_input.input == "udp"
| STATS drops = SUM(INCREASE(filebeat_input.system_packet_drops)) BY t = TBUCKET(5 minutes), agent.name
| SORT t

// P6 실패 문서. failure store 문서에는 data_stream.dataset이 없어 document.index로 묶는다
// 실패가 한 번도 없으면 ::failures 대상이 비어 Unknown column 오류가 난다
FROM logs-*::failures
| STATS failed = COUNT(*) BY document.index, error.type
| SORT failed DESC

// P7 원천별 마지막 수신(알림 rule에도 사용)
FROM logs-*
| WHERE event.ingested >= NOW() - 1 day
| STATS last_ingested = MAX(event.ingested) BY data_stream.dataset, host.name
| EVAL silent_min = DATE_DIFF("minutes", last_ingested, NOW())
| WHERE silent_min >= 15
| SORT silent_min DESC
