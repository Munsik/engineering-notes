{
  "title": "[Lab] Ingest flow",
  "description": "수집 흐름 대시보드(Engineering Notes 수집 06)",
  "time_range": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "vis",
      "grid": {
        "x": 0,
        "y": 0,
        "w": 48,
        "h": 14
      },
      "config": {
        "title": "P1 단계별 처리량(2분): Agent 출력 ack, Logstash 입력, Elasticsearch 저장",
        "type": "xy",
        "layers": [
          {
            "type": "line",
            "data_source": {
              "type": "esql",
              "query": "TS metrics-elastic_agent.elastic_agent-*, metrics-elastic_agent.filebeat-* | WHERE NOT component.id LIKE \"*monitoring*\" AND NOT component.id LIKE \"elasticsearch-*\" | STATS agent_acked = SUM(INCREASE(beat.stats.libbeat.output.events.acked)) BY t = TBUCKET(2 minutes) | SORT t"
            },
            "x": {
              "column": "t"
            },
            "y": [
              {
                "column": "agent_acked"
              }
            ]
          },
          {
            "type": "line",
            "data_source": {
              "type": "esql",
              "query": "TS metrics-logstash.pipeline-* | STATS logstash_in = SUM(INCREASE(`logstash.pipeline.total.events.in`)) BY t = TBUCKET(2 minutes) | SORT t"
            },
            "x": {
              "column": "t"
            },
            "y": [
              {
                "column": "logstash_in"
              }
            ]
          },
          {
            "type": "line",
            "data_source": {
              "type": "esql",
              "query": "FROM logs-* | WHERE event.ingested IS NOT NULL | STATS stored = COUNT(*) BY t = BUCKET(event.ingested, 2 minutes) | SORT t"
            },
            "x": {
              "column": "t"
            },
            "y": [
              {
                "column": "stored"
              }
            ]
          }
        ],
        "legend": {
          "placement": "outside",
          "position": "bottom",
          "visibility": "visible"
        }
      }
    },
    {
      "type": "vis",
      "grid": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 12
      },
      "config": {
        "title": "P2 수집 지연 p50, p95(초)",
        "type": "xy",
        "layers": [
          {
            "type": "line",
            "data_source": {
              "type": "esql",
              "query": "FROM logs-* | WHERE event.ingested IS NOT NULL | EVAL lag_s = DATE_DIFF(\"seconds\", @timestamp, event.ingested) | STATS p50 = PERCENTILE(lag_s, 50), p95 = PERCENTILE(lag_s, 95) BY t = BUCKET(@timestamp, 5 minutes) | SORT t"
            },
            "x": {
              "column": "t"
            },
            "y": [
              {
                "column": "p50"
              },
              {
                "column": "p95"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "vis",
      "grid": {
        "x": 24,
        "y": 14,
        "w": 24,
        "h": 12
      },
      "config": {
        "title": "P3 Agent queue 사용률 상위",
        "type": "data_table",
        "data_source": {
          "type": "esql",
          "query": "FROM metrics-elastic_agent.elastic_agent-*, metrics-elastic_agent.filebeat-* | WHERE NOT component.id LIKE \"*monitoring*\" AND beat.stats.libbeat.pipeline.queue.filled.pct IS NOT NULL | STATS filled = MAX(beat.stats.libbeat.pipeline.queue.filled.pct) BY agent.name, component.id | SORT filled DESC | LIMIT 20"
        },
        "rows": [
          {
            "column": "agent.name"
          },
          {
            "column": "component.id"
          }
        ],
        "metrics": [
          {
            "column": "filled"
          }
        ]
      }
    },
    {
      "type": "vis",
      "grid": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 12
      },
      "config": {
        "title": "P4 Logstash worker 사용률(노드별)",
        "type": "xy",
        "layers": [
          {
            "type": "line",
            "data_source": {
              "type": "esql",
              "query": "FROM metrics-logstash.pipeline-* | STATS backpressure = AVG(logstash.pipeline.total.flow.queue_backpressure.current), worker_util = AVG(logstash.pipeline.total.flow.worker_utilization.current) BY t = BUCKET(@timestamp, 5 minutes), logstash.pipeline.host.name | SORT t"
            },
            "x": {
              "column": "t"
            },
            "y": [
              {
                "column": "worker_util"
              }
            ],
            "breakdown_by": {
              "column": "logstash.pipeline.host.name"
            }
          }
        ],
        "legend": {
          "placement": "outside",
          "position": "bottom",
          "visibility": "visible"
        }
      }
    },
    {
      "type": "vis",
      "grid": {
        "x": 24,
        "y": 26,
        "w": 24,
        "h": 12
      },
      "config": {
        "title": "P5 UDP drop 증가분",
        "type": "xy",
        "layers": [
          {
            "type": "line",
            "data_source": {
              "type": "esql",
              "query": "TS metrics-elastic_agent.filebeat_input-* | WHERE filebeat_input.input == \"udp\" | STATS drops = SUM(INCREASE(filebeat_input.system_packet_drops)) BY t = TBUCKET(1 minute), agent.name | SORT t"
            },
            "x": {
              "column": "t"
            },
            "y": [
              {
                "column": "drops"
              }
            ],
            "breakdown_by": {
              "column": "agent.name"
            }
          }
        ],
        "legend": {
          "placement": "outside",
          "position": "bottom",
          "visibility": "visible"
        }
      }
    },
    {
      "type": "vis",
      "grid": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 12
      },
      "config": {
        "title": "P6 실패 문서",
        "type": "data_table",
        "data_source": {
          "type": "esql",
          "query": "FROM logs-*::failures | STATS failed = COUNT(*) BY document.index, error.type | SORT failed DESC"
        },
        "rows": [
          {
            "column": "document.index"
          },
          {
            "column": "error.type"
          }
        ],
        "metrics": [
          {
            "column": "failed"
          }
        ]
      }
    },
    {
      "type": "vis",
      "grid": {
        "x": 24,
        "y": 38,
        "w": 24,
        "h": 12
      },
      "config": {
        "title": "P7 원천별 마지막 수신(15분 이상 무수신)",
        "type": "data_table",
        "data_source": {
          "type": "esql",
          "query": "FROM logs-* | WHERE event.ingested >= NOW() - 1 day | STATS last_ingested = MAX(event.ingested) BY data_stream.dataset, host.name | EVAL silent_min = DATE_DIFF(\"minutes\", last_ingested, NOW()) | WHERE silent_min >= 15 | SORT silent_min DESC"
        },
        "rows": [
          {
            "column": "data_stream.dataset"
          },
          {
            "column": "host.name"
          }
        ],
        "metrics": [
          {
            "column": "silent_min"
          }
        ]
      }
    }
  ]
}