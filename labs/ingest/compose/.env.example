# 복사해서 .env로 저장한 뒤 값을 채웁니다. .env는 공유하지 않습니다
FLEET_URL=https://<deployment>.fleet.<region>.aws.elastic-cloud.com:443
ES_HOSTS=https://<deployment>.<region>.aws.elastic-cloud.com:443
# Fleet > Enrollment tokens에서 정책별 토큰을 복사
RECV_ENROLLMENT_TOKEN=
HOST_ENROLLMENT_TOKEN=
# README의 Dev Tools 요청으로 만든 키를 id:api_key 형식으로
ES_API_KEY=
AGENT_VERSION=9.5.4
LOGSTASH_VERSION=9.5.5
